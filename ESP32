/*
  Rayleigh RI-D440 Modbus RTU reader + Bluetooth (BLE) serial output
  ------------------------------------------------------------------
  LilyGo T-Display-S3. Polls the meter and sends the decoded readings
  to BOTH the USB Serial Monitor and Bluetooth.

  Bluetooth: the ESP32-S3 has BLE only (no classic Bluetooth), so this
  uses the standard "Nordic UART Service" - a BLE serial port.
  Phone apps:
    Android : "Serial Bluetooth Terminal" -> Devices -> Bluetooth LE tab
    iPhone  : "Bluefruit Connect" (UART) or "nRF Toolbox" (UART)
  Device name: "RI-D440 Meter"

  Meter defaults: 9600 baud, 8N1, slave 1, FC4 (input registers),
  values are 2-register FLOAT, low word first.

  Wiring:
    RS485 RO        -> GPIO18
    RS485 DI        -> GPIO17
    RS485 DE + RE   -> GPIO21
    RS485 VCC / GND -> 3V3 / GND
    RS485 A / B     -> Meter A / B

  Arduino IDE: Board "LilyGo T-Display-S3" (or ESP32S3 Dev Module),
               USB CDC On Boot: Enabled. No extra libraries needed.
*/

#include <string.h>
#include <math.h>
#include <stdarg.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

// ---------- Settings ----------
#define RS485_BAUD    9600
#define RS485_CONFIG  SERIAL_8N1
#define SLAVE_ID      1
#define FUNC_CODE     4        // 4 = measurements (input registers)
#define POLL_MS       2000     // read every 2 seconds
#define RESP_TIMEOUT  1000     // ms to wait for meter reply
#define REQ_GAP_MS    100      // pause before each request (meter is slow between frames)

#define BLE_NAME      "RI-D440 Meter"

// ---------- Pins ----------
#define RS485_RX_PIN  18
#define RS485_TX_PIN  17
#define RS485_DIR_PIN 21

// ---------- BLE UART (Nordic UART Service) ----------
#define NUS_SERVICE_UUID "6E400001-B5A3-F393-E0A9-E50E24DCCA9E"
#define NUS_RX_UUID      "6E400002-B5A3-F393-E0A9-E50E24DCCA9E"  // phone -> ESP32
#define NUS_TX_UUID      "6E400003-B5A3-F393-E0A9-E50E24DCCA9E"  // ESP32 -> phone

BLECharacteristic* txChar = nullptr;
volatile bool bleConnected = false;

class ServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer* s) override { bleConnected = true; }
  void onDisconnect(BLEServer* s) override {
    bleConnected = false;
    BLEDevice::startAdvertising();          // allow the phone to reconnect
  }
};

void bleSetup() {
  BLEDevice::init(BLE_NAME);
  BLEServer* server = BLEDevice::createServer();
  server->setCallbacks(new ServerCallbacks());

  BLEService* svc = server->createService(NUS_SERVICE_UUID);
  txChar = svc->createCharacteristic(NUS_TX_UUID, BLECharacteristic::PROPERTY_NOTIFY);
  txChar->addDescriptor(new BLE2902());
  svc->createCharacteristic(NUS_RX_UUID,
                            BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  svc->start();

  BLEAdvertising* adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(NUS_SERVICE_UUID);
  adv->setScanResponse(true);
  BLEDevice::startAdvertising();
}

// BLE sends max 20 bytes per packet by default, so split each line
void bleSend(const char* s, int len) {
  for (int i = 0; i < len; i += 20) {
    int n = (len - i > 20) ? 20 : (len - i);
    txChar->setValue((uint8_t*)(s + i), n);
    txChar->notify();
    delay(8);
  }
}

// printf to USB Serial and Bluetooth together
void out(const char* fmt, ...) {
  char line[128];
  va_list ap;
  va_start(ap, fmt);
  int n = vsnprintf(line, sizeof(line), fmt, ap);
  va_end(ap);
  if (n < 0) return;
  if (n >= (int)sizeof(line)) n = sizeof(line) - 1;
  Serial.write((const uint8_t*)line, n);
  if (bleConnected) bleSend(line, n);
}

// ---------- Register map (same as the Python script) ----------
struct Reg { uint16_t addr; const char* name; const char* unit; };

const Reg REGS[] = {
  {0x00, "V1-N", "V"}, {0x02, "V2-N", "V"}, {0x04, "V3-N", "V"}, {0x06, "V L-N avg", "V"},
  {0x08, "V1-2", "V"}, {0x0A, "V2-3", "V"}, {0x0C, "V3-1", "V"}, {0x0E, "V L-L avg", "V"},
  {0x10, "I1", "A"}, {0x12, "I2", "A"}, {0x14, "I3", "A"}, {0x16, "I avg", "A"},
  {0x18, "kW1", "kW"}, {0x1A, "kW2", "kW"}, {0x1C, "kW3", "kW"},
  {0x1E, "kVA1", "kVA"}, {0x20, "kVA2", "kVA"}, {0x22, "kVA3", "kVA"},
  {0x24, "kVAr1", "kVAr"}, {0x26, "kVAr2", "kVAr"}, {0x28, "kVAr3", "kVAr"},
  {0x2A, "Total kW", "kW"}, {0x2C, "Total kVA", "kVA"}, {0x2E, "Total kVAr", "kVAr"},
  {0x30, "PF1", ""}, {0x32, "PF2", ""}, {0x34, "PF3", ""}, {0x36, "PF avg", ""},
  {0x38, "Frequency", "Hz"},
  {0x3A, "Total net kWh", "kWh"}, {0x3E, "Total net kVArh", "kVArh"},
  {0x40, "kW demand", "kW"}, {0x48, "kVA demand", "kVA"},
  {0x86, "Max kW demand", "kW"}, {0x8A, "Max kVA demand", "kVA"},
};
const int NREGS = sizeof(REGS) / sizeof(REGS[0]);

// Blocks read per poll (start, count) - same as Python
const uint16_t BLOCKS[][2] = { {0x00, 0x20}, {0x20, 0x20}, {0x40, 0x0C}, {0x84, 0x0A} };
const int NBLOCKS = sizeof(BLOCKS) / sizeof(BLOCKS[0]);

uint16_t raw[0x90];   // register image, indexed by address

// ---------- Modbus helpers ----------
uint16_t crc16(const uint8_t* d, size_t n) {
  uint16_t c = 0xFFFF;
  for (size_t i = 0; i < n; i++) {
    c ^= d[i];
    for (int b = 0; b < 8; b++) c = (c & 1) ? (c >> 1) ^ 0xA001 : (c >> 1);
  }
  return c;
}

bool readBlock(uint16_t start, uint16_t count) {
  uint8_t req[8];
  req[0] = SLAVE_ID;
  req[1] = FUNC_CODE;
  req[2] = (uint8_t)(start >> 8);
  req[3] = (uint8_t)(start & 0xFF);
  req[4] = (uint8_t)(count >> 8);
  req[5] = (uint8_t)(count & 0xFF);
  uint16_t c = crc16(req, 6);
  req[6] = (uint8_t)(c & 0xFF);
  req[7] = (uint8_t)(c >> 8);

  while (Serial1.available()) Serial1.read();     // clear old bytes

  digitalWrite(RS485_DIR_PIN, HIGH);
  Serial1.write(req, 8);
  Serial1.flush();
  digitalWrite(RS485_DIR_PIN, LOW);

  uint8_t resp[80];
  size_t expected = 5 + 2 * count;
  size_t len = 0;
  uint32_t t0 = millis();
  while (len < expected && millis() - t0 < RESP_TIMEOUT) {
    if (Serial1.available()) {
      resp[len++] = Serial1.read();
      if (len == 5 && (resp[1] & 0x80)) break;   // exception reply
    }
  }

  if (len < 5) { out("No reply for block 0x%02X\n", start); return false; }
  if (resp[1] & 0x80) { out("Modbus exception %d at 0x%02X\n", resp[2], start); return false; }
  if (len < expected) { out("Short reply at 0x%02X (%d/%d bytes)\n", start, (int)len, (int)expected); return false; }

  uint16_t rc = resp[len - 2] | (resp[len - 1] << 8);
  if (rc != crc16(resp, len - 2)) { out("CRC error at 0x%02X\n", start); return false; }
  if (resp[0] != SLAVE_ID || resp[1] != FUNC_CODE || resp[2] != 2 * count) {
    out("Bad frame at 0x%02X\n", start); return false;
  }

  for (uint16_t i = 0; i < count; i++)
    raw[start + i] = (resp[3 + 2 * i] << 8) | resp[4 + 2 * i];
  return true;
}

float toFloat(uint16_t lo, uint16_t hi) {   // "reverse word": low word first
  uint32_t u = ((uint32_t)hi << 16) | lo;
  float f;
  memcpy(&f, &u, 4);
  return f;
}

// ---------- Main ----------
void setup() {
  pinMode(RS485_DIR_PIN, OUTPUT);
  digitalWrite(RS485_DIR_PIN, LOW);
  Serial.begin(115200);
  Serial1.begin(RS485_BAUD, RS485_CONFIG, RS485_RX_PIN, RS485_TX_PIN);
  gpio_pullup_en((gpio_num_t)RS485_RX_PIN);   // pull-up without detaching the pin from the UART
  bleSetup();
  delay(1000);
  out("RI-D440 reader started (Bluetooth: %s)\n", BLE_NAME);
}

void loop() {
  bool ok = true;
  for (int b = 0; b < NBLOCKS && ok; b++) {
    ok = false;
    for (int attempt = 0; attempt < 3 && !ok; attempt++) {
      delay(REQ_GAP_MS);                          // meter needs a pause between requests
      ok = readBlock(BLOCKS[b][0], BLOCKS[b][1]);
    }
  }

  if (ok) {
    out("\n=== RI-D440 (slave %d, S/N %04X%04X) uptime %lus ===\n",
        SLAVE_ID, raw[0x85], raw[0x84], millis() / 1000);
    for (int i = 0; i < NREGS; i++) {
      float v = toFloat(raw[REGS[i].addr], raw[REGS[i].addr + 1]);
      if (strcmp(REGS[i].unit, "kW") == 0) {          // e.g. 012.345
        char s[20];
        snprintf(s, sizeof(s), "%s%07.3f", v < 0 ? "-" : "", fabs(v));
        out("  %-16s %14s %s\n", REGS[i].name, s, REGS[i].unit);
      } else {
        out("  %-16s %14.3f %s\n", REGS[i].name, v, REGS[i].unit);
      }
    }
  }

  delay(POLL_MS);
}
